<!DOCTYPE html>
<html>
<head>
  <title>Food Ordering System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

  <h2 class="text-center mb-4">🍔 Food Ordering System</h2>

  <!-- ADD FOOD -->
  <form action="/add-food" method="POST" class="mb-4 p-3 bg-white shadow rounded">

    <input name="name" class="form-control mb-2" placeholder="Food Name" required>

    <input name="price" class="form-control mb-2" placeholder="Price" required>

    <button class="btn btn-success w-100">Add Food</button>

  </form>

  <!-- FOOD LIST -->
  <div class="bg-white p-3 shadow rounded">

    <table class="table table-bordered">

      <thead class="table-dark">
        <tr>
          <th>Food</th>
          <th>Price</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% if (typeof foods !== "undefined") { %>
          <% foods.forEach(food => { %>
            <tr>
              <td><%= food.name %></td>
              <td>₹<%= food.price %></td>
              <td>
                <form action="/order/<%= food.id %>" method="POST">
                  <button class="btn btn-primary btn-sm">Order</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>

    </table>

  </div>

</div>

</body>
</html>
